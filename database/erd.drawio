        <mxCell id="integrity_notes" value="&lt;b&gt;REFERENTIAL INTEGRITY &amp;amp; POLICIES&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #CBD5E1; margin: 6px 0;&quot;&gt;&lt;div style=&quot;font-size: 11px; color: #334155; line-height: 1.55;&quot;&gt;&amp;bull; &lt;b&gt;users &amp;harr; user_profiles&lt;/b&gt; (1 : 1)&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; ON UPDATE CASCADE / DELETE CASCADE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; Profile otomatis terhapus saat user dihapus.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;categories &amp;rarr; products&lt;/b&gt; (1 : N)&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; ON UPDATE CASCADE / DELETE RESTRICT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; Kategori tidak dapat dihapus jika masih ada produk.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;products &amp;harr; suppliers&lt;/b&gt; (N : M)&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; Junction: &lt;i&gt;product_suppliers&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; Composite PK (product_id, supplier_id)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; ON UPDATE CASCADE / DELETE CASCADE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;products &amp;rarr; stock_movements&lt;/b&gt; (1 : N)&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; ON UPDATE CASCADE / DELETE RESTRICT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #64748B; margin-left: 10px;&quot;&gt;&amp;bull; Produk dengan riwayat stok tidak boleh dihapus.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;users &amp;rarr; stock_movements&lt;/b&gt; (1 : N)&lt;br&gt;&lt;span style=&quot;color: #6