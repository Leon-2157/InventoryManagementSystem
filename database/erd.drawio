        <mxCell id="header_banner" value="&lt;div style=&quot;line-height: 1.4;&quot;&gt;&lt;span style=&quot;font-size: 19px; font-weight: 700; color: #FFFFFF; letter-spacing: 0.5px;&quot;&gt;INVENTORY MANAGEMENT SYSTEM &amp;mdash; ENTITY RELATIONSHIP DIAGRAM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400; color: #94A3B8;&quot;&gt;Relational Data Model &amp;bull; Engine: MySQL 8.0 (InnoDB) &amp;bull; Source: database/schema.sql &amp;bull; Crow's Foot Notation&lt;/span&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=25;whiteSpace=wrap;html=1;shadow=1;" vertex="1" parent="1">
