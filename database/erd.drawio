        <mxCell id="legend_box" value="&lt;b&gt;SCHEMA CONVENTIONS &amp;amp; NOTATION&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #CBD5E1; margin: 6px 0;&quot;&gt;&lt;table style=&quot;font-size: 11px; width: 100%; text-align: left; border-collapse: collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;Primary Key&lt;/td&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;b&gt;||&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;1 (Mandatory)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;[FK]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;Foreign Key&lt;/td&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;b&gt;O|&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;0 or 1 (Optional)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;font color=&quot;#059669&quot;&gt;&lt;b&gt;[UQ]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;Unique Constraint&lt;/td&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;gt;&amp;lt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;0..N (Many)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;font color=&quot;#4B5563&quot;&gt;&lt;b&gt;[AI]&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;Auto Increment&lt;/td&gt;&lt;td style=&quot;padding: 2px 0;&quot;&gt;&lt;b&gt;|&amp;lt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color: #475569;&quot;&gt;1..N (1 or Many)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rectangle;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;html=1;shadow=1;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" vertex=